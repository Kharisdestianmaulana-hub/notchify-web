---
import { translations } from '../data/translations';
const tEn = translations.en.simulator;
const tId = translations.id.simulator;
const explanationsEn = translations.en.simulator.explanations;
const explanationsId = translations.id.simulator.explanations;
---

<section id="demo" class="py-14 sm:py-20 md:py-28 relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-12">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold text-white tracking-tight mb-2.5" data-en={tEn.title} data-id={tId.title}>
        {tEn.title}
      </h2>
      <p class="text-sm sm:text-base text-neutral-400 font-normal leading-relaxed" data-en={tEn.subtitle} data-id={tId.subtitle}>
        {tEn.subtitle}
      </p>
    </div>

    <!-- LAPTOP PRATINJAU -->
    <div class="laptop" id="laptop">
      <div class="lid">
        <div class="bezel">
          <!-- WebCam Hardware Dot -->
          <span class="cam"></span>

          <!-- Screen Area with Authentic macOS Wallpaper -->
          <div class="screen">
            <!-- Sleek macOS Ambient Wallpaper (GPU-friendly, zero lag) -->
            <div class="mac-wallpaper" aria-hidden="true"></div>

            <!-- REAL NOTCHIFY OVERLAY (Scaled by --u) -->
            <div class="mn-holder" id="mnHolder">
              <div class="mn" id="mn" data-s="idle" role="img" aria-label="Notchify Notch Preview">

                <!-- 1. TOP BAR NAVIGATION (Inside Notchify, visible in all expanded modes) -->
                <div class="notch-topbar absolute top-0 left-0 right-0 h-9 px-4 flex items-center justify-between border-b border-white/[0.08] z-30 select-none">
                  <!-- Left Tab Icons (SVGs - No Emojis) -->
                  <div class="flex items-center gap-4 text-white/50 text-xs">
                    <!-- Tab 1: Music -->
                    <button type="button" class="tab-icon hover:text-white transition-colors cursor-pointer" data-target="music" title="Music & Lyrics">
                      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
                    </button>
                    <!-- Tab 2: Clipboard -->
                    <button type="button" class="tab-icon hover:text-white transition-colors cursor-pointer" data-target="clipboard" title="Clipboard">
                      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19 2h-4.18C14.4.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 18H5V4h2v3h10V4h2v16z"/></svg>
                    </button>
                    <!-- Tab 3: Shelf / Dropzone -->
                    <button type="button" class="tab-icon hover:text-white transition-colors cursor-pointer" data-target="shelf" title="Dropzone">
                      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"/></svg>
                    </button>
                    <!-- Tab 4: Pomodoro Timer -->
                    <button type="button" class="tab-icon hover:text-white transition-colors cursor-pointer" data-target="pomodoro" title="Focus Timer">
                      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M15 1H9v2h6V1zm-4 13h2V8h-2v6zm8.03-6.61l1.42-1.42c-.43-.51-.9-.99-1.41-1.41l-1.42 1.42C16.07 4.74 14.12 4 12 4c-4.97 0-9 4.03-9 9s4.02 9 9 9 9-4.03 9-9c0-2.12-.74-4.07-1.97-5.61zM12 20c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7-3.13 7-7 7z"/></svg>
                    </button>
                    <!-- Tab 5: System Monitor -->
                    <button type="button" class="tab-icon hover:text-white transition-colors cursor-pointer" data-target="system" title="System Monitor">
                      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"/></svg>
                    </button>
                  </div>

                  <!-- Right Mascot Avatar -->
                  <div class="relative w-5 h-5 rounded-md bg-gradient-to-tr from-[#16a34a] via-[#84cc16] to-[#f97316] flex items-center justify-center shadow-sm overflow-hidden flex-shrink-0 cursor-pointer" title="Notchify Mascot">
                    <div class="eyes flex items-center justify-center gap-0.5">
                      <span class="blink-eye w-0.5 h-1 rounded-full bg-white"></span>
                      <span class="blink-eye w-0.5 h-1 rounded-full bg-white"></span>
                    </div>
                  </div>
                </div>

                <!-- 2. SIDE CHEVRONS (< and >) -->
                <div class="notch-chevrons pointer-events-none">
                  <button type="button" id="prev-chevron" class="pointer-events-auto absolute left-2 top-[60%] -translate-y-1/2 w-5 h-5 rounded-full bg-white/10 hover:bg-white/20 border border-white/10 flex items-center justify-center text-white/80 transition-colors z-30 cursor-pointer" title="Previous">
                    <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
                  </button>
                  <button type="button" id="next-chevron" class="pointer-events-auto absolute right-2 top-[60%] -translate-y-1/2 w-5 h-5 rounded-full bg-white/10 hover:bg-white/20 border border-white/10 flex items-center justify-center text-white/80 transition-colors z-30 cursor-pointer" title="Next">
                    <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                  </button>
                </div>

                <!-- 3. BOTTOM PAGINATION DOTS (6 Dots for 6 Modes) -->
                <div class="notch-dots absolute bottom-1.5 left-1/2 -translate-x-1/2 flex items-center gap-1.5 z-30 pointer-events-none">
                  <span class="p-dot w-4 h-1 rounded-full bg-white transition-all duration-200" data-idx="0"></span>
                  <span class="p-dot w-1 h-1 rounded-full bg-white/30 transition-all duration-200" data-idx="1"></span>
                  <span class="p-dot w-1 h-1 rounded-full bg-white/30 transition-all duration-200" data-idx="2"></span>
                  <span class="p-dot w-1 h-1 rounded-full bg-white/30 transition-all duration-200" data-idx="3"></span>
                  <span class="p-dot w-1 h-1 rounded-full bg-white/30 transition-all duration-200" data-idx="4"></span>
                  <span class="p-dot w-1 h-1 rounded-full bg-white/30 transition-all duration-200" data-idx="5"></span>
                </div>

                <!-- ============================================================== -->
                <!-- VIEW: IDLE STATE (100% Matching Screenshot media_1792912797867) -->
                <!-- ============================================================== -->
                <div class="ly l-idle absolute inset-0 flex items-center justify-between px-3 cursor-pointer">
                  <!-- Green Activity Ring -->
                  <div class="w-3.5 h-3.5 rounded-full border-2 border-apple-green flex-shrink-0"></div>
                  <!-- Day & Time -->
                  <div class="text-[12px] font-semibold tracking-tight text-white/95">
                    Sun 14:18
                  </div>
                  <!-- Golden Resting Mascot Eyes -->
                  <div class="sleeping-eyes" title="Resting">
                    <span class="sleeping-eye"></span>
                    <span class="sleeping-eye"></span>
                  </div>
                </div>

                <!-- ============================================================== -->
                <!-- VIEW: MUSIK & LIRIK (Screenshot 1)                             -->
                <!-- ============================================================== -->
                <div class="ly l-music pt-10 px-7 pb-3 h-full flex items-center justify-between">
                  <!-- Left: Player -->
                  <div class="w-[200px] flex-shrink-0 flex items-center gap-3 pr-3 border-r border-white/10">
                    <!-- Album Cover -->
                    <div class="relative w-12 h-12 rounded-lg bg-neutral-900 border border-white/15 overflow-hidden flex-shrink-0 flex flex-col items-center justify-center">
                      <span class="text-[7.5px] font-black text-center text-white/90 leading-tight uppercase px-1">CHARLIE PUTH</span>
                      <span class="text-[6px] text-white/60">CHEATING ON YOU</span>
                      <div class="absolute bottom-0.5 right-0.5 w-3 h-3 rounded-full bg-red-600 flex items-center justify-center">
                        <svg class="w-1.5 h-1.5 fill-white" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/></svg>
                      </div>
                    </div>
                    <!-- Track Details -->
                    <div class="flex-1 min-w-0">
                      <div class="text-[12.5px] font-bold text-white truncate">Cheating on You</div>
                      <div class="text-[9.5px] text-white/60 truncate">Charlie Puth – Cheating on You</div>
                      <!-- Scrubber -->
                      <div class="flex items-center gap-1.5 mt-1.5 text-[8.5px] font-mono text-white/50">
                        <span>00:27</span>
                        <div class="flex-1 h-1 rounded-full bg-white/20 overflow-hidden">
                          <div class="h-full bg-white rounded-full w-[22%]"></div>
                        </div>
                        <span>-02:49</span>
                      </div>
                      <!-- Controls -->
                      <div class="flex items-center justify-between mt-1 text-white/90">
                        <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
                        <div class="flex items-center gap-2">
                          <svg class="w-3.5 h-3.5 hover:text-white cursor-pointer" fill="currentColor" viewBox="0 0 24 24"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
                          <svg class="w-4 h-4 hover:text-white cursor-pointer" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                          <svg class="w-3.5 h-3.5 hover:text-white cursor-pointer" fill="currentColor" viewBox="0 0 24 24"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
                        </div>
                        <span class="w-2"></span>
                      </div>
                    </div>
                  </div>

                  <!-- Right: Live Synced Lyrics -->
                  <div class="flex-1 pl-4 flex flex-col justify-center text-left select-none overflow-hidden">
                    <div class="text-[10px] text-white/35 font-medium truncate">run away?</div>
                    <div class="text-[13px] font-bold text-white leading-snug my-0.5 tracking-tight">
                      Oh, your love was everything, everything, everything
                    </div>
                    <div class="text-[10px] text-white/40 font-medium truncate">I know it's gettin' late, gettin'</div>
                  </div>
                </div>

                <!-- ============================================================== -->
                <!-- VIEW: CLIPBOARD TERBARU (Screenshot 2)                        -->
                <!-- ============================================================== -->
                <div class="ly l-clipboard pt-10 px-8 pb-3 h-full flex flex-col justify-start">
                  <div class="flex items-center gap-1.5 mb-2 px-1">
                    <svg class="w-3.5 h-3.5 text-apple-blue fill-current" viewBox="0 0 24 24"><path d="M19 2h-4.18C14.4.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 18H5V4h2v3h10V4h2v16z"/></svg>
                    <span class="text-[12.5px] font-bold text-white" data-en="Recent Clipboard" data-id="Clipboard Terbaru">Clipboard Terbaru</span>
                  </div>
                  <div class="w-full rounded-xl bg-[#11131a] border border-white/5 p-3 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                      <div class="w-8 h-8 rounded-full bg-apple-blue/20 flex items-center justify-center text-apple-blue flex-shrink-0">
                        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg>
                      </div>
                      <div class="text-left">
                        <div class="text-[13px] font-bold text-white" data-en="Clipboard Empty" data-id="Papan Klip Kosong">Papan Klip Kosong</div>
                        <div class="text-[10px] text-white/50" data-en="Copied texts and snippets will appear here..." data-id="Teks dan potongan yang disalin...">Teks dan potongan yang disalin...</div>
                      </div>
                    </div>
                    <div class="px-2 py-0.5 rounded bg-white/10 text-white/80 font-mono text-[10.5px] font-bold border border-white/10">
                      Cmd C
                    </div>
                  </div>
                </div>

                <!-- ============================================================== -->
                <!-- VIEW: ZONA LEPAS / DROPZONE (Screenshot 3)                    -->
                <!-- ============================================================== -->
                <div class="ly l-shelf pt-10 px-8 pb-3 h-full flex flex-col justify-start">
                  <div class="flex items-center gap-1.5 mb-2 px-1">
                    <svg class="w-3.5 h-3.5 text-sky-400 fill-current" viewBox="0 0 24 24"><path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"/></svg>
                    <span class="text-[12.5px] font-bold text-white" data-en="Drop Zone" data-id="Zona Lepas">Zona Lepas</span>
                  </div>
                  <div class="w-full rounded-xl border-[1.5px] border-dashed border-sky-400/35 bg-sky-500/[0.04] p-3 flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-sky-500/20 flex items-center justify-center text-sky-400 flex-shrink-0">
                      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"/></svg>
                    </div>
                    <div class="text-left">
                      <div class="text-[13px] font-bold text-white" data-en="Drop Files Here" data-id="Lepas File di Sini">Lepas File di Sini</div>
                      <div class="text-[10px] text-white/50" data-en="Quick holding space for drag and drop..." data-id="Penyimpanan cepat untuk seret & lepas f...">Penyimpanan cepat untuk seret & lepas f...</div>
                    </div>
                  </div>
                </div>

                <!-- ============================================================== -->
                <!-- VIEW: TIMER FOKUS / POMODORO (Screenshot 4)                   -->
                <!-- ============================================================== -->
                <div class="ly l-pomodoro pt-10 px-8 pb-3 h-full flex flex-col justify-start">
                  <div class="flex items-center gap-1.5 mb-2 px-1">
                    <svg class="w-3.5 h-3.5 text-amber-500 fill-current" viewBox="0 0 24 24"><path d="M15 1H9v2h6V1zm-4 13h2V8h-2v6zm8.03-6.61l1.42-1.42c-.43-.51-.9-.99-1.41-1.41l-1.42 1.42C16.07 4.74 14.12 4 12 4c-4.97 0-9 4.03-9 9s4.02 9 9 9 9-4.03 9-9c0-2.12-.74-4.07-1.97-5.61zM12 20c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7-3.13 7-7 7z"/></svg>
                    <span class="text-[12.5px] font-bold text-white" data-en="Focus Timer" data-id="Timer Fokus">Timer Fokus</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <!-- Preset 1: 25m Focus -->
                    <div class="flex-1 py-1.5 px-2 rounded-xl border border-amber-500 bg-amber-500/15 flex flex-col items-center justify-center">
                      <span class="text-[12px] font-bold text-white">25m</span>
                      <span class="text-[8px] text-amber-300 font-semibold uppercase" data-en="Focus" data-id="Fokus">Fokus</span>
                    </div>
                    <!-- Preset 2: 15m -->
                    <div class="flex-1 py-1.5 px-2 rounded-xl border border-white/10 bg-white/5 flex flex-col items-center justify-center">
                      <span class="text-[12px] font-bold text-white/80">15m</span>
                      <span class="text-[8px] text-white/40 uppercase" data-en="Chill" data-id="Santai">Santai</span>
                    </div>
                    <!-- Preset 3: 5m -->
                    <div class="flex-1 py-1.5 px-2 rounded-xl border border-white/10 bg-white/5 flex flex-col items-center justify-center">
                      <span class="text-[12px] font-bold text-white/80">5m</span>
                      <span class="text-[8px] text-white/40 uppercase" data-en="Break" data-id="Istirahat">Istirahat</span>
                    </div>
                    <!-- Preset 4: 30m Custom -->
                    <div class="flex-1 py-1.5 px-2 rounded-xl border border-white/10 bg-white/5 flex flex-col items-center justify-center">
                      <span class="text-[12px] font-bold text-white/80">30m</span>
                      <span class="text-[8px] text-white/40 uppercase" data-en="Custom" data-id="Kustom">Kustom</span>
                    </div>
                    <!-- Stepper -->
                    <div class="flex items-center gap-1.5 px-2 py-1.5 rounded-xl bg-white/10 text-[11px] font-bold text-white">
                      <span>−</span>
                      <span>25 mnt</span>
                      <span>+</span>
                    </div>
                    <!-- Action Button -->
                    <button type="button" class="px-3.5 py-2 rounded-full bg-gradient-to-r from-orange-500 to-red-500 text-white font-bold text-[11px] shadow flex items-center gap-1">
                      <span data-en="Start Focus" data-id="Mulai Fokus">Mulai Fokus</span>
                    </button>
                  </div>
                </div>

                <!-- ============================================================== -->
                <!-- VIEW: HUD SISTEM / SPEEDOMETER (Screenshot 5)                 -->
                <!-- ============================================================== -->
                <div class="ly l-system pt-10 px-8 pb-3 h-full flex flex-col justify-center gap-2">
                  <!-- Row 1: CPU -->
                  <div>
                    <div class="flex items-center justify-between text-[11px] font-bold mb-0.5">
                      <span class="text-white">CPU</span>
                      <span class="text-apple-green font-mono">27%</span>
                    </div>
                    <div class="w-full h-1.5 rounded-full bg-white/10 overflow-hidden">
                      <div class="h-full rounded-full bg-apple-green w-[27%]"></div>
                    </div>
                  </div>

                  <!-- Row 2: RAM -->
                  <div>
                    <div class="flex items-center justify-between text-[11px] font-bold mb-0.5">
                      <span class="text-white">RAM</span>
                      <span class="text-white/80 font-mono text-[10px]">12.5 GB / 20.0 GB</span>
                    </div>
                    <div class="w-full h-1.5 rounded-full bg-white/10 overflow-hidden">
                      <div class="h-full rounded-full bg-amber-500 w-[62.5%]"></div>
                    </div>
                  </div>

                  <!-- Row 3: Baterai -->
                  <div>
                    <div class="flex items-center justify-between text-[11px] font-bold mb-0.5">
                      <span class="text-white" data-en="Battery • Full" data-id="Baterai • Daya Penuh">Baterai • Daya Penuh</span>
                      <span class="text-apple-green font-mono">100%</span>
                    </div>
                    <div class="w-full h-1.5 rounded-full bg-white/10 overflow-hidden">
                      <div class="h-full rounded-full bg-apple-green w-[100%]"></div>
                    </div>
                  </div>
                </div>

              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mode Selector Tabs under Laptop (Clean SVG Icons - Zero Emojis) -->
    <div class="mt-6 sm:mt-8 flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 px-1 max-w-xl mx-auto">
      <!-- Idle Button -->
      <button
        type="button"
        class="sim-btn is-active"
        data-mode="idle"
      >
        <span class="w-2 h-2 rounded-full border border-current"></span>
        <span data-en={tEn.tabIdle} data-id={tId.tabIdle}>{tEn.tabIdle}</span>
      </button>

      <!-- Music Button -->
      <button
        type="button"
        class="sim-btn"
        data-mode="music"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
        <span data-en={tEn.tabMedia} data-id={tId.tabMedia}>{tEn.tabMedia}</span>
      </button>

      <!-- Clipboard Button -->
      <button
        type="button"
        class="sim-btn"
        data-mode="clipboard"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19 2h-4.18C14.4.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 18H5V4h2v3h10V4h2v16z"/></svg>
        <span data-en={tEn.tabClipboard} data-id={tId.tabClipboard}>{tEn.tabClipboard}</span>
      </button>

      <!-- Shelf Button -->
      <button
        type="button"
        class="sim-btn"
        data-mode="shelf"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"/></svg>
        <span data-en={tEn.tabShelf} data-id={tId.tabShelf}>{tEn.tabShelf}</span>
      </button>

      <!-- Pomodoro Button -->
      <button
        type="button"
        class="sim-btn"
        data-mode="pomodoro"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M15 1H9v2h6V1zm-4 13h2V8h-2v6zm8.03-6.61l1.42-1.42c-.43-.51-.9-.99-1.41-1.41l-1.42 1.42C16.07 4.74 14.12 4 12 4c-4.97 0-9 4.03-9 9s4.02 9 9 9 9-4.03 9-9c0-2.12-.74-4.07-1.97-5.61zM12 20c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7-3.13 7-7 7z"/></svg>
        <span data-en={tEn.tabPomodoro} data-id={tId.tabPomodoro}>{tEn.tabPomodoro}</span>
      </button>

      <!-- System Button -->
      <button
        type="button"
        class="sim-btn"
        data-mode="system"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"/></svg>
        <span data-en={tEn.tabSystem} data-id={tId.tabSystem}>{tEn.tabSystem}</span>
      </button>
    </div>

    <!-- Dynamic Explanation Area (Under Mode Buttons) -->
    <div class="mt-8 sm:mt-12 pt-6 sm:pt-8 border-t border-white/[0.08] max-w-2xl mx-auto text-center px-2 sm:px-0">
      <span id="sim-exp-index" class="text-xs font-mono text-neutral-500 uppercase tracking-widest block mb-2">
        01 / 06 — RESTING
      </span>
      <h3 id="sim-exp-title" class="text-xl sm:text-2xl font-medium text-white tracking-tight mb-1">
        {tEn.explanations.idle.title}
      </h3>
      <p id="sim-exp-tagline" class="text-xs font-mono text-neutral-300 mb-3">
        {tEn.explanations.idle.tagline}
      </p>
      <p id="sim-exp-desc" class="text-sm text-neutral-400 font-normal leading-relaxed">
        {tEn.explanations.idle.desc}
      </p>
    </div>
  </div>
</section>

<!-- Client Script: Fast, responsive 60fps notch controller & dynamic explanation sync -->
<script is:inline define:vars={{ explanationsEn, explanationsId }}>
  (function() {
    const notch = document.getElementById('mn');
    const buttons = document.querySelectorAll('.sim-btn');
    const tabIcons = document.querySelectorAll('.tab-icon');
    const paginationDots = document.querySelectorAll('.p-dot');
    const prevChevron = document.getElementById('prev-chevron');
    const nextChevron = document.getElementById('next-chevron');

    const expIndexEl = document.getElementById('sim-exp-index');
    const expTitleEl = document.getElementById('sim-exp-title');
    const expTaglineEl = document.getElementById('sim-exp-tagline');
    const expDescEl = document.getElementById('sim-exp-desc');

    const modes = ['idle', 'music', 'clipboard', 'shelf', 'pomodoro', 'system'];
    let currentModeIndex = 0; // default to idle initially

    function fitLaptop() {
      const laptop = document.getElementById('laptop');
      if (!laptop) return;
      const w = laptop.clientWidth;
      // Allow scale down to 0.44 on narrow screens so notch (530px * 0.44 = 233px) easily fits even 280px viewports
      const u = Math.max(0.44, Math.min(1.25, (w - 20) / 540));
      document.documentElement.style.setProperty('--u', u.toFixed(3));
    }
    fitLaptop();
    window.addEventListener('resize', fitLaptop, { passive: true });

    function updateSimulator(mode) {
      if (!notch) return;
      notch.setAttribute('data-s', mode);

      buttons.forEach(btn => {
        const btnMode = btn.getAttribute('data-mode');
        const isActive = btnMode === mode;
        btn.classList.toggle('is-active', isActive);
      });

      tabIcons.forEach(icon => {
        const target = icon.getAttribute('data-target');
        const isActive = target === mode;
        icon.classList.toggle('text-white', isActive);
        icon.classList.toggle('opacity-100', isActive);
        icon.classList.toggle('opacity-40', !isActive);
      });

      const modeIdx = modes.indexOf(mode);
      if (modeIdx !== -1) {
        currentModeIndex = modeIdx;
        paginationDots.forEach((dot, idx) => {
          if (idx === modeIdx) {
            dot.classList.remove('w-1', 'bg-white/30');
            dot.classList.add('w-4', 'bg-white');
          } else {
            dot.classList.remove('w-4', 'bg-white');
            dot.classList.add('w-1', 'bg-white/30');
          }
        });
      }

      // Update Dynamic Explanation Area
      const lang = document.documentElement.getAttribute('data-lang') || 'en';
      const dict = lang === 'id' ? explanationsId : explanationsEn;
      const item = dict[mode] || dict.idle;
      const numStr = String(currentModeIndex + 1).padStart(2, '0');

      if (expIndexEl) expIndexEl.textContent = `${numStr} / 06 — ${mode.toUpperCase()}`;
      if (expTitleEl) expTitleEl.textContent = item.title;
      if (expTaglineEl) expTaglineEl.textContent = item.tagline;
      if (expDescEl) expDescEl.textContent = item.desc;
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-mode');
        if (mode) updateSimulator(mode);
      });
    });

    tabIcons.forEach(icon => {
      icon.addEventListener('click', (e) => {
        e.stopPropagation();
        const target = icon.getAttribute('data-target');
        if (target) updateSimulator(target);
      });
    });

    if (prevChevron) {
      prevChevron.addEventListener('click', (e) => {
        e.stopPropagation();
        currentModeIndex = (currentModeIndex - 1 + modes.length) % modes.length;
        updateSimulator(modes[currentModeIndex]);
      });
    }

    if (nextChevron) {
      nextChevron.addEventListener('click', (e) => {
        e.stopPropagation();
        currentModeIndex = (currentModeIndex + 1) % modes.length;
        updateSimulator(modes[currentModeIndex]);
      });
    }

    // Hover on idle blooms directly into music
    if (notch) {
      notch.addEventListener('mouseenter', () => {
        if (notch.getAttribute('data-s') === 'idle') {
          updateSimulator('music');
        }
      });
    }

    // Listen to language changes to update explanation text immediately
    window.addEventListener('langchange', () => {
      updateSimulator(modes[currentModeIndex]);
    });

    updateSimulator('idle');
  })();
</script>
