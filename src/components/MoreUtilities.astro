---
import { translations } from '../data/translations';
const tEn = translations.en.moreUtilities;
const tId = translations.id.moreUtilities;
---

<section id="utilities" class="py-20 sm:py-28 md:py-36 relative bg-void overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Header: Apple Editorial Typography -->
    <div class="max-w-3xl mb-12 sm:mb-16 md:mb-20">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.04] border border-white/10 text-[11px] sm:text-xs font-mono uppercase tracking-widest text-neutral-400 mb-4 sm:mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-neutral-400"></span>
        <span data-en={tEn.badge} data-id={tId.badge}>{tEn.badge}</span>
      </div>
      <h2
        class="text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight text-white mb-4 sm:mb-5 leading-[1.08]"
        data-en={tEn.title}
        data-id={tId.title}
      >
        {tEn.title}
      </h2>
      <p
        class="text-base sm:text-lg md:text-xl text-neutral-400 font-normal leading-relaxed max-w-2xl"
        data-en={tEn.subtitle}
        data-id={tId.subtitle}
      >
        {tEn.subtitle}
      </p>
    </div>

    <!-- Bento Grid (3-column asymmetric layout with Apple obsidian dark styling) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
      
      <!-- CARD 1: File Shelf & Staging (Large - 2 Columns) -->
      <div class="md:col-span-2 lg:col-span-2 rounded-3xl p-6 sm:p-8 bg-[#0a0a0d] border border-white/[0.08] hover:border-white/[0.18] transition-all duration-300 relative overflow-hidden flex flex-col justify-between group">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent pointer-events-none"></div>

        <div class="relative z-10 mb-8 max-w-xl">
          <span class="inline-block text-[11px] font-mono uppercase tracking-wider text-neutral-400 mb-2">
            {tEn.items[0].tag}
          </span>
          <h3 class="text-xl sm:text-2xl font-semibold text-white tracking-tight mb-2" data-en={tEn.items[0].title} data-id={tId.items[0].title}>
            {tEn.items[0].title}
          </h3>
          <p class="text-sm text-neutral-400 leading-relaxed font-normal" data-en={tEn.items[0].desc} data-id={tId.items[0].desc}>
            {tEn.items[0].desc}
          </p>
        </div>

        <!-- Visual Miniature: Top screen bezel with notch and drop shelf -->
        <div class="relative z-10 w-full pt-4">
          <div class="w-full rounded-2xl bg-black/80 border border-white/[0.06] p-4 sm:p-5 relative overflow-hidden">
            <!-- Simulated MacBook Bezel Notch -->
            <div class="w-28 sm:w-36 h-6 bg-black border-b border-x border-white/15 rounded-b-xl mx-auto flex items-center justify-center gap-2 mb-4 shadow-sm">
              <span class="w-2 h-2 rounded-full bg-[#181818] border border-white/10"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            </div>

            <!-- Staged File Cards Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
              <!-- Item 1: Image -->
              <div class="p-3 rounded-xl bg-white/[0.03] border border-white/[0.08] flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-white/[0.06] border border-white/10 flex items-center justify-center flex-shrink-0 text-white/80">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <div class="min-w-0 flex-1">
                  <span class="block text-xs font-medium text-white truncate">preview.png</span>
                  <span class="block text-[10px] font-mono text-neutral-500">2.4 MB</span>
                </div>
              </div>

              <!-- Item 2: Code File -->
              <div class="p-3 rounded-xl bg-white/[0.03] border border-white/[0.08] flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-orange-500/15 border border-orange-400/20 flex items-center justify-center flex-shrink-0 text-orange-400 font-mono text-xs font-semibold">
                  SW
                </div>
                <div class="min-w-0 flex-1">
                  <span class="block text-xs font-medium text-white truncate">Notchify.swift</span>
                  <span class="block text-[10px] font-mono text-neutral-500">18 KB</span>
                </div>
              </div>

              <!-- Item 3: Drop target prompt -->
              <div class="col-span-2 sm:col-span-1 p-3 rounded-xl border border-dashed border-white/15 bg-white/[0.015] flex items-center justify-center gap-2 text-neutral-400">
                <svg class="w-4 h-4 animate-bounce text-neutral-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                </svg>
                <span class="text-xs font-mono text-neutral-400">Drop to stage</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- CARD 2: Audio Control & Synced Lyrics (1 Column) -->
      <div class="md:col-span-1 lg:col-span-1 rounded-3xl p-6 sm:p-8 bg-[#0a0a0d] border border-white/[0.08] hover:border-white/[0.18] transition-all duration-300 relative overflow-hidden flex flex-col justify-between group">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent pointer-events-none"></div>

        <div class="relative z-10 mb-6">
          <span class="inline-block text-[11px] font-mono uppercase tracking-wider text-neutral-400 mb-2">
            {tEn.items[1].tag}
          </span>
          <h3 class="text-xl font-semibold text-white tracking-tight mb-2" data-en={tEn.items[1].title} data-id={tId.items[1].title}>
            {tEn.items[1].title}
          </h3>
          <p class="text-sm text-neutral-400 leading-relaxed font-normal" data-en={tEn.items[1].desc} data-id={tId.items[1].desc}>
            {tEn.items[1].desc}
          </p>
        </div>

        <!-- Visual Miniature: Notch Media Pill & Lyrics -->
        <div class="relative z-10 w-full pt-2">
          <div class="rounded-2xl bg-black/80 border border-white/[0.06] p-4 flex flex-col gap-3">
            <!-- Now Playing Notch Pill -->
            <div class="flex items-center justify-between px-3 py-2 rounded-xl bg-white/[0.03] border border-white/[0.08]">
              <div class="flex items-center gap-2.5 min-w-0">
                <div class="w-6 h-6 rounded-md bg-neutral-800 border border-white/10 flex items-center justify-center flex-shrink-0 shadow-sm">
                  <svg class="w-3 h-3 text-white fill-current" viewBox="0 0 24 24">
                    <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z" />
                  </svg>
                </div>
                <div class="min-w-0">
                  <span class="block text-xs font-semibold text-white truncate">Daylight</span>
                  <span class="block text-[10px] text-neutral-400 truncate">Taylor Swift</span>
                </div>
              </div>
              <!-- Mini Soundwave -->
              <div class="flex items-end gap-1 h-3 flex-shrink-0">
                <span class="w-0.5 h-3 bg-white/80 rounded-full animate-pulse"></span>
                <span class="w-0.5 h-2 bg-white/80 rounded-full animate-pulse delay-75"></span>
                <span class="w-0.5 h-3.5 bg-white/80 rounded-full animate-pulse delay-150"></span>
                <span class="w-0.5 h-1.5 bg-white/80 rounded-full animate-pulse delay-100"></span>
              </div>
            </div>

            <!-- Synced Lyric Preview -->
            <div class="space-y-1.5 pt-1 border-t border-white/[0.04]">
              <p class="text-xs font-medium text-white/95 tracking-tight leading-snug">
                "And I can still see it all in my head"
              </p>
              <p class="text-[11px] text-neutral-500 leading-snug">
                "Back and forth from New York sneaking in your bed"
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- CARD 3: Pomodoro Focus Timer (1 Column) -->
      <div class="rounded-3xl p-6 sm:p-8 bg-[#0a0a0d] border border-white/[0.08] hover:border-white/[0.18] transition-all duration-300 relative overflow-hidden flex flex-col justify-between group">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent pointer-events-none"></div>

        <div class="relative z-10 mb-6">
          <span class="inline-block text-[11px] font-mono uppercase tracking-wider text-neutral-400 mb-2">
            {tEn.items[2].tag}
          </span>
          <h3 class="text-xl font-semibold text-white tracking-tight mb-2" data-en={tEn.items[2].title} data-id={tId.items[2].title}>
            {tEn.items[2].title}
          </h3>
          <p class="text-sm text-neutral-400 leading-relaxed font-normal" data-en={tEn.items[2].desc} data-id={tId.items[2].desc}>
            {tEn.items[2].desc}
          </p>
        </div>

        <!-- Visual Miniature: Notch Focus Timer Capsule -->
        <div class="relative z-10 w-full pt-2">
          <div class="rounded-2xl bg-black/80 border border-white/[0.06] p-4 flex flex-col items-center text-center">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.04] border border-white/10 mb-3">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
              <span class="text-[11px] font-mono text-neutral-300 uppercase tracking-wider">Deep Sprint</span>
            </div>
            <div class="text-3xl font-mono font-bold text-white tracking-wider mb-2.5">
              24:18
            </div>
            <div class="w-full h-1.5 rounded-full bg-white/10 overflow-hidden">
              <div class="h-full bg-white/80 w-[78%] rounded-full"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- CARD 4: Instant Clipboard Memory (1 Column) -->
      <div class="rounded-3xl p-6 sm:p-8 bg-[#0a0a0d] border border-white/[0.08] hover:border-white/[0.18] transition-all duration-300 relative overflow-hidden flex flex-col justify-between group">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent pointer-events-none"></div>

        <div class="relative z-10 mb-6">
          <span class="inline-block text-[11px] font-mono uppercase tracking-wider text-neutral-400 mb-2">
            {tEn.items[3].tag}
          </span>
          <h3 class="text-xl font-semibold text-white tracking-tight mb-2" data-en={tEn.items[3].title} data-id={tId.items[3].title}>
            {tEn.items[3].title}
          </h3>
          <p class="text-sm text-neutral-400 leading-relaxed font-normal" data-en={tEn.items[3].desc} data-id={tId.items[3].desc}>
            {tEn.items[3].desc}
          </p>
        </div>

        <!-- Visual Miniature: Stacked Clip Chips -->
        <div class="relative z-10 w-full pt-2">
          <div class="rounded-2xl bg-black/80 border border-white/[0.06] p-3 space-y-2">
            <!-- Chip 1 -->
            <div class="flex items-center justify-between p-2 rounded-xl bg-white/[0.03] border border-white/[0.08] text-xs">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded bg-[#0071e3] flex-shrink-0"></span>
                <span class="font-mono text-white/90">#0071E3</span>
              </div>
              <span class="text-[10px] font-mono text-neutral-500">Color</span>
            </div>
            <!-- Chip 2 -->
            <div class="flex items-center justify-between p-2 rounded-xl bg-white/[0.03] border border-white/[0.08] text-xs">
              <div class="flex items-center gap-2 min-w-0">
                <span class="text-neutral-500 font-mono text-[11px]">&gt;</span>
                <span class="font-mono text-neutral-300 truncate">git clone notchify.git</span>
              </div>
              <span class="text-[10px] font-mono text-neutral-500">CLI</span>
            </div>
          </div>
        </div>
      </div>

      <!-- CARD 5: Peripherals & Battery HUD (1 Column) -->
      <div class="rounded-3xl p-6 sm:p-8 bg-[#0a0a0d] border border-white/[0.08] hover:border-white/[0.18] transition-all duration-300 relative overflow-hidden flex flex-col justify-between group">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent pointer-events-none"></div>

        <div class="relative z-10 mb-6">
          <span class="inline-block text-[11px] font-mono uppercase tracking-wider text-neutral-400 mb-2">
            {tEn.items[4].tag}
          </span>
          <h3 class="text-xl font-semibold text-white tracking-tight mb-2" data-en={tEn.items[4].title} data-id={tId.items[4].title}>
            {tEn.items[4].title}
          </h3>
          <p class="text-sm text-neutral-400 leading-relaxed font-normal" data-en={tEn.items[4].desc} data-id={tId.items[4].desc}>
            {tEn.items[4].desc}
          </p>
        </div>

        <!-- Visual Miniature: Device Heads-Up Banner -->
        <div class="relative z-10 w-full pt-2">
          <div class="rounded-2xl bg-black/80 border border-white/[0.06] p-3 space-y-2">
            <div class="flex items-center justify-between p-2.5 rounded-xl bg-white/[0.03] border border-white/[0.08]">
              <div class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                <span class="text-xs font-medium text-white">MagSafe Charger</span>
              </div>
              <span class="text-xs font-mono font-bold text-emerald-400">100%</span>
            </div>
            <div class="flex items-center justify-between p-2.5 rounded-xl bg-white/[0.03] border border-white/[0.08]">
              <div class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-white/80" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 3a9 9 0 00-9 9v7c0 1.1.9 2 2 2h2a2 2 0 002-2v-4a2 2 0 00-2-2H5v-1a7 7 0 0114 0v1h-2a2 2 0 00-2 2v4a2 2 0 002 2h2c1.1 0 2-.9 2-2v-7a9 9 0 00-9-9z"/>
                </svg>
                <span class="text-xs font-medium text-white">AirPods Pro</span>
              </div>
              <span class="text-xs font-mono text-neutral-400">88%</span>
            </div>
          </div>
        </div>
      </div>

      <!-- CARD 6: Mindful Hydration Milestones (1 Column) -->
      <div class="rounded-3xl p-6 sm:p-8 bg-[#0a0a0d] border border-white/[0.08] hover:border-white/[0.18] transition-all duration-300 relative overflow-hidden flex flex-col justify-between group">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent pointer-events-none"></div>

        <div class="relative z-10 mb-6">
          <span class="inline-block text-[11px] font-mono uppercase tracking-wider text-neutral-400 mb-2">
            {tEn.items[5].tag}
          </span>
          <h3 class="text-xl font-semibold text-white tracking-tight mb-2" data-en={tEn.items[5].title} data-id={tId.items[5].title}>
            {tEn.items[5].title}
          </h3>
          <p class="text-sm text-neutral-400 leading-relaxed font-normal" data-en={tEn.items[5].desc} data-id={tId.items[5].desc}>
            {tEn.items[5].desc}
          </p>
        </div>

        <!-- Visual Miniature: Hydration Meter Pill -->
        <div class="relative z-10 w-full pt-2">
          <div class="rounded-2xl bg-black/80 border border-white/[0.06] p-4 flex flex-col items-center">
            <div class="flex items-center gap-2 mb-2.5">
              <svg class="w-4 h-4 text-white fill-current" viewBox="0 0 24 24">
                <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
              </svg>
              <span class="text-lg font-mono font-bold text-white tracking-tight">1.5 L</span>
              <span class="text-xs font-mono text-neutral-500">/ 2.0 L</span>
            </div>
            <!-- 8 Glass segments -->
            <div class="grid grid-cols-8 gap-1.5 w-full mb-2">
              <span class="h-2 rounded-full bg-white/90"></span>
              <span class="h-2 rounded-full bg-white/90"></span>
              <span class="h-2 rounded-full bg-white/90"></span>
              <span class="h-2 rounded-full bg-white/90"></span>
              <span class="h-2 rounded-full bg-white/90"></span>
              <span class="h-2 rounded-full bg-white/90"></span>
              <span class="h-2 rounded-full bg-white/15"></span>
              <span class="h-2 rounded-full bg-white/15"></span>
            </div>
            <span class="text-[10px] font-mono text-neutral-500">Next reminder in 24m</span>
          </div>
        </div>
      </div>

      <!-- CARD 7: Apple Silicon Hardware Telemetry (Large - 2 Columns) -->
      <div class="md:col-span-2 lg:col-span-2 rounded-3xl p-6 sm:p-8 bg-[#0a0a0d] border border-white/[0.08] hover:border-white/[0.18] transition-all duration-300 relative overflow-hidden flex flex-col justify-between group">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent pointer-events-none"></div>

        <div class="relative z-10 mb-8 max-w-xl">
          <span class="inline-block text-[11px] font-mono uppercase tracking-wider text-neutral-400 mb-2">
            {tEn.items[6].tag}
          </span>
          <h3 class="text-xl sm:text-2xl font-semibold text-white tracking-tight mb-2" data-en={tEn.items[6].title} data-id={tId.items[6].title}>
            {tEn.items[6].title}
          </h3>
          <p class="text-sm text-neutral-400 leading-relaxed font-normal" data-en={tEn.items[6].desc} data-id={tId.items[6].desc}>
            {tEn.items[6].desc}
          </p>
        </div>

        <!-- Visual Miniature: Apple Silicon Telemetry Cockpit -->
        <div class="relative z-10 w-full pt-2">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <!-- Metric 1: Unified CPU Load -->
            <div class="p-4 rounded-2xl bg-black/80 border border-white/[0.06]">
              <div class="flex items-center justify-between text-neutral-400 mb-1.5">
                <span class="text-[11px] font-mono uppercase text-neutral-400">CPU Load</span>
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              </div>
              <div class="text-2xl font-mono font-bold text-white mb-2">12%</div>
              <div class="w-full h-1.5 rounded-full bg-white/10 overflow-hidden">
                <div class="h-full bg-white/80 w-[12%] rounded-full"></div>
              </div>
              <span class="block text-[10px] font-mono text-neutral-500 mt-2">M-Series Cores</span>
            </div>

            <!-- Metric 2: Memory Pressure -->
            <div class="p-4 rounded-2xl bg-black/80 border border-white/[0.06]">
              <div class="flex items-center justify-between text-neutral-400 mb-1.5">
                <span class="text-[11px] font-mono uppercase text-neutral-400">RAM Pressure</span>
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              </div>
              <div class="text-2xl font-mono font-bold text-white mb-2">5.8 GB</div>
              <div class="w-full h-1.5 rounded-full bg-white/10 overflow-hidden">
                <div class="h-full bg-emerald-400/80 w-[32%] rounded-full"></div>
              </div>
              <span class="block text-[10px] font-mono text-neutral-500 mt-2">Nominal Pressure</span>
            </div>

            <!-- Metric 3: Thermals & Battery -->
            <div class="p-4 rounded-2xl bg-black/80 border border-white/[0.06]">
              <div class="flex items-center justify-between text-neutral-400 mb-1.5">
                <span class="text-[11px] font-mono uppercase text-neutral-400">Efficiency</span>
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              </div>
              <div class="text-2xl font-mono font-bold text-white mb-2">36°C</div>
              <div class="w-full h-1.5 rounded-full bg-white/10 overflow-hidden">
                <div class="h-full bg-white/80 w-[98%] rounded-full"></div>
              </div>
              <span class="block text-[10px] font-mono text-neutral-500 mt-2">Fan 0 RPM • Silent</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
