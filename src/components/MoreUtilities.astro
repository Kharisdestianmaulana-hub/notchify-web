---
import { translations } from '../data/translations';
const tEn = translations.en.moreUtilities;
const tId = translations.id.moreUtilities;
---

<section id="utilities" class="py-16 sm:py-24 md:py-32 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Header: Editorial Minimalist -->
    <div class="max-w-2xl mb-10 sm:mb-16 md:mb-20">
      <span class="block text-xs font-mono uppercase tracking-widest text-neutral-500 mb-3" data-en={tEn.badge} data-id={tId.badge}>
        {tEn.badge}
      </span>
      <h2 class="text-2xl sm:text-4xl md:text-5xl font-semibold text-white tracking-tight mb-3 sm:mb-4" data-en={tEn.title} data-id={tId.title}>
        {tEn.title}
      </h2>
      <p class="text-sm sm:text-base md:text-lg text-neutral-400 leading-relaxed font-normal" data-en={tEn.subtitle} data-id={tId.subtitle}>
        {tEn.subtitle}
      </p>
    </div>

    <!-- Editorial Index Grid (No Cards, Pure Typography) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 sm:gap-x-10 gap-y-10 sm:gap-y-14">
      {tEn.items.map((item, idx) => {
        const idItem = tId.items[idx];
        const num = String(idx + 1).padStart(2, '0');
        return (
          <div class="pt-6 border-t border-white/[0.08] flex flex-col justify-between group">
            <div>
              <span class="block text-xs font-mono text-neutral-500 mb-4 tracking-wider group-hover:text-neutral-300 transition-colors">
                {num}
              </span>
              <h3 class="text-base font-medium text-white mb-2.5 tracking-tight group-hover:text-neutral-100 transition-colors" data-en={item.title} data-id={idItem.title}>
                {item.title}
              </h3>
              <p class="text-sm text-neutral-400 font-normal leading-relaxed" data-en={item.desc} data-id={idItem.desc}>
                {item.desc}
              </p>
            </div>
            <div class="mt-6 pt-3 border-t border-white/[0.04] text-[11px] font-mono text-neutral-500">
              <span data-en={item.tag} data-id={idItem.tag}>{item.tag}</span>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
