---
import { translations } from '../data/translations';
const tEn = translations.en.comparison;
const tId = translations.id.comparison;
---

<section id="compare" class="py-20 sm:py-28 md:py-36 relative bg-void overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.04] border border-white/10 text-neutral-400 font-mono text-[11px] uppercase tracking-wider mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span data-en={tEn.badge} data-id={tId.badge}>{tEn.badge}</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-bold text-white tracking-tight mb-4" data-en={tEn.title} data-id={tId.title}>
        {tEn.title}
      </h2>
      <p class="text-base sm:text-lg text-neutral-400 font-normal leading-relaxed" data-en={tEn.subtitle} data-id={tId.subtitle}>
        {tEn.subtitle}
      </p>
    </div>

    <!-- Comparison Obsidian Card -->
    <div class="rounded-3xl bg-[#0a0a0d] border border-white/[0.08] hover:border-white/[0.14] transition-all relative overflow-hidden shadow-2xl p-4 sm:p-8 md:p-10">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/20 to-transparent pointer-events-none"></div>

      <!-- Responsive Table Wrapper -->
      <div class="overflow-x-auto -mx-4 sm:mx-0 px-4 sm:px-0">
        <table class="w-full text-left border-collapse min-w-[620px]">
          <!-- Table Header -->
          <thead>
            <tr class="border-b border-white/[0.08]">
              <th scope="col" class="pb-5 pt-2 text-xs font-mono uppercase tracking-wider text-neutral-500 font-medium w-[28%]">
                <span data-en="Benchmark Metric" data-id="Kriteria Tolok Ukur">Benchmark Metric</span>
              </th>

              <!-- Notchify Column Header (Highlighted) -->
              <th scope="col" class="pb-5 pt-2 px-4 text-left w-[32%] bg-emerald-500/[0.04] rounded-t-2xl border-t border-x border-emerald-500/20 relative">
                <div class="flex items-center justify-between gap-2">
                  <div class="flex items-center gap-2">
                    <span class="text-base sm:text-lg font-bold text-white tracking-tight">Notchify</span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-emerald-400/10 text-emerald-300 border border-emerald-400/25">
                      v1.0.0
                    </span>
                  </div>
                  <span class="text-[10px] font-mono uppercase text-emerald-400 font-medium hidden sm:inline-block" data-en={tEn.colNotchifyTag} data-id={tId.colNotchifyTag}>
                    {tEn.colNotchifyTag}
                  </span>
                </div>
              </th>

              <!-- Paid Notch Apps Column Header -->
              <th scope="col" class="pb-5 pt-2 px-4 text-left text-xs font-mono uppercase tracking-wider text-neutral-400 font-medium w-[20%]">
                <span data-en={tEn.colPaid} data-id={tId.colPaid}>{tEn.colPaid}</span>
              </th>

              <!-- Electron / Web Apps Column Header -->
              <th scope="col" class="pb-5 pt-2 px-4 text-left text-xs font-mono uppercase tracking-wider text-neutral-400 font-medium w-[20%]">
                <span data-en={tEn.colElectron} data-id={tId.colElectron}>{tEn.colElectron}</span>
              </th>
            </tr>
          </thead>

          <!-- Table Body -->
          <tbody class="divide-y divide-white/[0.04] text-xs sm:text-sm">
            {tEn.rows.map((row, idx) => {
              const idRow = tId.rows[idx];
              return (
                <tr class="hover:bg-white/[0.015] transition-colors group">
                  <!-- Metric Label -->
                  <td class="py-4 pr-3 text-neutral-300 font-medium">
                    <span data-en={row.metric} data-id={idRow.metric}>{row.metric}</span>
                  </td>

                  <!-- Notchify (Hero Spec Column) -->
                  <td class="py-4 px-4 bg-emerald-500/[0.04] border-x border-emerald-500/20 font-semibold text-white">
                    <div class="flex items-center gap-2">
                      <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      <span data-en={row.notchify} data-id={idRow.notchify}>{row.notchify}</span>
                    </div>
                  </td>

                  <!-- Paid Apps -->
                  <td class="py-4 px-4 text-neutral-400 font-normal">
                    <span data-en={row.paid} data-id={idRow.paid}>{row.paid}</span>
                  </td>

                  <!-- Electron Apps -->
                  <td class="py-4 px-4 text-neutral-500 font-normal">
                    <span data-en={row.electron} data-id={idRow.electron}>{row.electron}</span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <!-- Bottom Callout Footer -->
      <div class="mt-8 pt-6 border-t border-white/[0.06] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 flex-shrink-0">
            <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <p class="text-xs sm:text-sm text-neutral-300 font-normal" data-en={tEn.ctaNote} data-id={tId.ctaNote}>
            {tEn.ctaNote}
          </p>
        </div>

        <a
          href="#download"
          class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full text-xs font-semibold bg-white text-neutral-950 hover:bg-neutral-200 transition-colors shadow-sm flex-shrink-0"
        >
          <span data-en={tEn.ctaBtn} data-id={tId.ctaBtn}>{tEn.ctaBtn}</span>
          <svg class="w-3.5 h-3.5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
