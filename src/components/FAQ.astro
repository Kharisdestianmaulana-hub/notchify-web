---
import { translations } from '../data/translations';
const tEn = translations.en.faq;
const tId = translations.id.faq;
---

<section id="faq" class="py-20 md:py-28 relative">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold text-white tracking-tight mb-2.5" data-en={tEn.title} data-id={tId.title}>
        {tEn.title}
      </h2>
      <p class="text-sm sm:text-base text-neutral-400 font-normal leading-relaxed" data-en={tEn.subtitle} data-id={tId.subtitle}>
        {tEn.subtitle}
      </p>
    </div>

    <!-- Accordion Items: Clean Neutral Dark Glass -->
    <div class="space-y-3">
      {tEn.items.map((item, idx) => {
        const idItem = tId.items[idx];
        return (
          <details class="group rounded-xl bg-white/[0.02] hover:bg-white/[0.03] border border-white/[0.07] hover:border-white/[0.14] open:border-white/20 open:bg-white/[0.03] p-5 sm:p-6 [&_summary::-webkit-details-marker]:hidden transition-all duration-200">
            <summary class="flex items-center justify-between cursor-pointer select-none">
              <h3 class="text-[15px] sm:text-base font-semibold text-white/90 group-hover:text-white transition-colors pr-4 tracking-tight" data-en={item.q} data-id={idItem.q}>
                {item.q}
              </h3>
              <div class="w-7 h-7 rounded-full bg-white/[0.04] border border-white/10 flex items-center justify-center flex-shrink-0 text-neutral-400 group-open:rotate-180 group-open:text-white transition-transform">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </summary>
            <p class="text-[13px] sm:text-sm text-neutral-400 font-normal leading-relaxed mt-3.5 pt-3.5 border-t border-white/[0.04]" data-en={item.a} data-id={idItem.a}>
              {item.a}
            </p>
          </details>
        );
      })}
    </div>
  </div>
</section>
