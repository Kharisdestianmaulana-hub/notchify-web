---
import { translations } from '../data/translations';
const tEn = translations.en.nav;
const tId = translations.id.nav;
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-white/[0.06] bg-black/70 backdrop-blur-xl">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand -->
    <a href="#" class="flex items-center gap-2.5 group">
      <img src="/logo.png" alt="Notchify Logo" class="w-7 h-7 rounded-lg shadow-md transition-transform duration-200 group-hover:scale-105" />
      <span class="font-semibold text-base tracking-tight text-white">
        Notchify
      </span>
      <span class="hidden sm:inline-block text-[10px] font-mono font-medium px-2 py-0.5 rounded-full bg-white/[0.05] text-neutral-400 border border-white/10">
        macOS
      </span>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-center gap-7 text-xs font-medium text-neutral-400">
      <a href="#features" class="hover:text-white transition-colors" data-en={tEn.features} data-id={tId.features}>{tEn.features}</a>
      <a href="#demo" class="hover:text-white transition-colors" data-en={tEn.demo} data-id={tId.demo}>{tEn.demo}</a>
      <a href="#permissions" class="hover:text-white transition-colors" data-en={tEn.permissions} data-id={tId.permissions}>{tEn.permissions}</a>
      <a href="#faq" class="hover:text-white transition-colors" data-en={tEn.faq} data-id={tId.faq}>{tEn.faq}</a>
    </nav>

    <!-- Right Controls: Language Toggle & GitHub / Download -->
    <div class="flex items-center gap-2.5">
      <!-- Language Switcher (EN / ID) -->
      <div class="relative flex items-center p-0.5 rounded-full bg-white/[0.04] border border-white/10 text-[11px] font-mono font-medium" role="group" aria-label="Language Selector">
        <button
          type="button"
          class="lang-btn px-2.5 py-1 rounded-full transition-all duration-200"
          data-lang-target="en"
          onclick="window.setLanguage('en')"
        >
          EN
        </button>
        <button
          type="button"
          class="lang-btn px-2.5 py-1 rounded-full transition-all duration-200"
          data-lang-target="id"
          onclick="window.setLanguage('id')"
        >
          ID
        </button>
      </div>

      <!-- GitHub Link -->
      <a
        href="https://github.com/Kharisdestianmaulana-hub/notchify"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-white/[0.04] border border-white/10 text-neutral-300 hover:text-white hover:border-white/20 transition-all"
        title="View repository on GitHub"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>GitHub</span>
      </a>

      <!-- Download Action -->
      <a
        id="nav-download-btn"
        href="#download"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-white/[0.08] text-neutral-300 border border-white/10 hover:bg-white/15 transition-all shadow-sm"
      >
        <span id="nav-download-dot" class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
        <span id="nav-download-text" data-en={tEn.download} data-id={tId.download}>{tEn.download}</span>
        <span id="nav-version-tag" class="text-[10px] font-mono text-amber-300/80">Dev</span>
        <svg class="w-3.5 h-3.5 opacity-60" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v7.586l2.293-2.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 111.414-1.414L9 11.586V4a1 1 0 011-1z" clip-rule="evenodd" />
          <path d="M4 17a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1z" />
        </svg>
      </a>
    </div>
  </div>
</header>
