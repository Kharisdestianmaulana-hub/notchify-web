---
import { translations } from '../data/translations';
const tEn = translations.en.howItWorks;
const tId = translations.id.howItWorks;
---

<section class="py-20 sm:py-28 md:py-36 relative bg-void overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Header: Apple Editorial Typography -->
    <div class="max-w-3xl mb-12 sm:mb-16 md:mb-20">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.04] border border-white/10 text-[11px] sm:text-xs font-mono uppercase tracking-widest text-neutral-400 mb-4 sm:mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-neutral-400"></span>
        <span>Ergonomics & Interaction</span>
      </div>
      <h2 class="text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight text-white mb-4 sm:mb-5 leading-[1.08]" data-en={tEn.title} data-id={tId.title}>
        {tEn.title}
      </h2>
      <p class="text-base sm:text-lg md:text-xl text-neutral-400 font-normal leading-relaxed max-w-2xl" data-en={tEn.subtitle} data-id={tId.subtitle}>
        {tEn.subtitle}
      </p>
    </div>

    <!-- 3-Column Apple Obsidian Workflow Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6">
      
      <!-- Card 1: Shortcut -->
      <div class="rounded-3xl p-6 sm:p-8 bg-[#0a0a0d] border border-white/[0.08] hover:border-white/[0.18] transition-all duration-300 relative overflow-hidden flex flex-col justify-between group">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent pointer-events-none"></div>

        <div>
          <span class="block text-[11px] font-mono text-neutral-500 mb-3 tracking-wider uppercase">
            01 / Shortcut First
          </span>
          <h3 class="text-xl font-semibold text-white tracking-tight mb-2.5" data-en={tEn.shortcutTitle} data-id={tId.shortcutTitle}>
            {tEn.shortcutTitle}
          </h3>
          <p class="text-sm text-neutral-400 leading-relaxed font-normal mb-8" data-en={tEn.shortcutDesc} data-id={tId.shortcutDesc}>
            {tEn.shortcutDesc}
          </p>
        </div>

        <!-- Visual: Authentic Mac Keycaps -->
        <div class="pt-6 border-t border-white/[0.06]">
          <div class="flex items-center gap-2 mb-2">
            <kbd class="px-3 py-1.5 rounded-lg bg-neutral-900 border border-white/20 text-xs font-mono font-medium text-white shadow-inner">⌘ Cmd</kbd>
            <span class="text-neutral-500 text-xs">+</span>
            <kbd class="px-3 py-1.5 rounded-lg bg-neutral-900 border border-white/20 text-xs font-mono font-medium text-white shadow-inner">⇧ Shift</kbd>
            <span class="text-neutral-500 text-xs">+</span>
            <kbd class="px-3 py-1.5 rounded-lg bg-neutral-900 border border-white/20 text-xs font-mono font-medium text-white shadow-inner">N</kbd>
          </div>
          <span class="text-[11px] font-mono text-neutral-500">Universal system hotkey</span>
        </div>
      </div>

      <!-- Card 2: Triggers / Interaction -->
      <div class="rounded-3xl p-6 sm:p-8 bg-[#0a0a0d] border border-white/[0.08] hover:border-white/[0.18] transition-all duration-300 relative overflow-hidden flex flex-col justify-between group">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent pointer-events-none"></div>

        <div>
          <span class="block text-[11px] font-mono text-neutral-500 mb-3 tracking-wider uppercase">
            02 / Interaction
          </span>
          <h3 class="text-xl font-semibold text-white tracking-tight mb-2.5" data-en={tEn.triggerTitle} data-id={tId.triggerTitle}>
            {tEn.triggerTitle}
          </h3>
          <p class="text-sm text-neutral-400 leading-relaxed font-normal mb-8" data-en={tEn.triggerDesc} data-id={tId.triggerDesc}>
            {tEn.triggerDesc}
          </p>
        </div>

        <!-- Visual: Trackpad Proximity Simulation -->
        <div class="pt-6 border-t border-white/[0.06]">
          <div class="flex items-center justify-between p-2.5 rounded-xl bg-white/[0.03] border border-white/[0.08] mb-2 text-xs font-mono">
            <span class="text-neutral-300">Hover to Bloom</span>
            <span class="text-neutral-600">•</span>
            <span class="text-neutral-400">Click to Expand</span>
          </div>
          <span class="text-[11px] font-mono text-neutral-500">Configurable in Preferences</span>
        </div>
      </div>

      <!-- Card 3: Fullscreen Evasion -->
      <div class="rounded-3xl p-6 sm:p-8 bg-[#0a0a0d] border border-white/[0.08] hover:border-white/[0.18] transition-all duration-300 relative overflow-hidden flex flex-col justify-between group">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent pointer-events-none"></div>

        <div>
          <span class="block text-[11px] font-mono text-neutral-500 mb-3 tracking-wider uppercase">
            03 / Intelligence
          </span>
          <h3 class="text-xl font-semibold text-white tracking-tight mb-2.5" data-en={tEn.fullscreenTitle} data-id={tId.fullscreenTitle}>
            {tEn.fullscreenTitle}
          </h3>
          <p class="text-sm text-neutral-400 leading-relaxed font-normal mb-8" data-en={tEn.fullscreenDesc} data-id={tId.fullscreenDesc}>
            {tEn.fullscreenDesc}
          </p>
        </div>

        <!-- Visual: Auto-hide Tag & Clean Status -->
        <div class="pt-6 border-t border-white/[0.06]">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span class="text-xs font-mono text-white/90">Evasion Active in Keynote & Movies</span>
          </div>
          <span class="text-[11px] font-mono text-neutral-500">Never covers active presentations</span>
        </div>
      </div>

    </div>
  </div>
</section>
