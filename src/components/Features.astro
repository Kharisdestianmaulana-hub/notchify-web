---
import { translations } from '../data/translations';
const tEn = translations.en.features;
const tId = translations.id.features;

// Clean, precise monochrome SVG icons for each feature
const icons = [
  // 1. Fluid Spring Dynamics (Wave / Elastic motion)
  `<svg class="w-5 h-5 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
  // 2. Automatic Fullscreen Evasion (Window / Screen expand)
  `<svg class="w-5 h-5 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" /></svg>`,
  // 3. Global Shortcut Access (Keyboard / Hotkey)
  `<svg class="w-5 h-5 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 4v1m6 11h2m-6 0h-4v4m0-4v-4m0 4h4m-4-8h4V4m0 4h4V4M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>`,
  // 4. Staging File Shelf (Tray / Drop target)
  `<svg class="w-5 h-5 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>`,
  // 5. Synced Lyrics & Audio Control (Sound wave / Music)
  `<svg class="w-5 h-5 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" /></svg>`,
  // 6. Near-Zero Footprint (Microchip / Efficiency)
  `<svg class="w-5 h-5 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" /></svg>`,
  // 7. Dual Language Support (Translate / Globe)
  `<svg class="w-5 h-5 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" /></svg>`,
  // 8. Zero Remote Telemetry (Shield / Local only)
  `<svg class="w-5 h-5 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`,
];
---

<section id="features" class="py-24 md:py-36 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Header: Editorial Minimalist -->
    <div class="max-w-2xl mb-16 sm:mb-20">
      <span class="block text-xs font-mono uppercase tracking-widest text-neutral-500 mb-3">Architecture & Engineering</span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-semibold text-white tracking-tight mb-4" data-en={tEn.title} data-id={tId.title}>
        {tEn.title}
      </h2>
      <p class="text-base sm:text-lg text-neutral-400 leading-relaxed font-normal" data-en={tEn.subtitle} data-id={tId.subtitle}>
        {tEn.subtitle}
      </p>
    </div>

    <!-- Editorial Index Grid (No Cards, Pure Typography) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12">
      {tEn.items.map((item, idx) => {
        const idItem = tId.items[idx];
        const num = String(idx + 1).padStart(2, '0');
        return (
          <div class="pt-6 border-t border-white/[0.08] flex flex-col justify-between group">
            <div>
              <span class="block text-xs font-mono text-neutral-500 mb-4 tracking-wider group-hover:text-neutral-300 transition-colors">
                {num}
              </span>
              <h3 class="text-base font-medium text-white mb-2.5 tracking-tight group-hover:text-neutral-100 transition-colors" data-en={item.title} data-id={idItem.title}>
                {item.title}
              </h3>
              <p class="text-sm text-neutral-400 font-normal leading-relaxed" data-en={item.desc} data-id={idItem.desc}>
                {item.desc}
              </p>
            </div>
            <div class="mt-6 pt-3 border-t border-white/[0.04] text-[11px] font-mono text-neutral-500">
              <span data-en={item.tag} data-id={idItem.tag}>{item.tag}</span>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
