---
import { translations } from '../data/translations';
const tEn = translations.en.downloadSec;
const tId = translations.id.downloadSec;
---

<section id="download" class="py-20 md:py-32 relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
    <!-- App Icon -->
    <div class="w-20 h-20 sm:w-24 sm:h-24 mx-auto mb-6 relative">
      <img
        src="/app-icon.png"
        alt="Notchify App Icon"
        class="w-full h-full rounded-[22px] shadow-[0_20px_40px_rgba(0,0,0,0.6)] border border-white/10"
        onerror="this.src='/logo.png'"
      />
    </div>

    <!-- Title & Lede -->
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold text-white tracking-tight mb-2.5" data-en={tEn.title} data-id={tId.title}>
      {tEn.title}
    </h2>
    <p class="text-sm sm:text-base text-neutral-400 font-normal leading-relaxed max-w-xl mx-auto mb-10" data-en={tEn.subtitle} data-id={tId.subtitle}>
      {tEn.subtitle}
    </p>

    <!-- Main Download Card -->
    <div class="p-7 sm:p-10 rounded-2xl bg-white/[0.02] border border-white/[0.07] relative overflow-hidden mb-6">
      <div class="flex flex-col items-center">
        <!-- Status Banner: In Development / Public Release -->
        <div id="section-status-banner" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-xs font-mono text-amber-300 mb-5">
          <span id="section-status-dot" class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
          <span id="section-status-text" data-en={tEn.statusDevBanner} data-id={tId.statusDevBanner}>
            {tEn.statusDevBanner}
          </span>
        </div>

        <!-- Download Action Button (Disabled while in development, auto-activates when GitHub Release is published) -->
        <a
          id="section-download-btn"
          href="https://github.com/Kharisdestianmaulana-hub/notchify"
          class="inline-flex items-center justify-center gap-2.5 w-full sm:w-auto px-7 py-3.5 rounded-full bg-white/[0.06] border border-white/10 text-neutral-400 font-medium text-sm transition-all cursor-not-allowed select-none mb-3"
          aria-disabled="true"
        >
          <svg class="w-4 h-4 fill-current opacity-60" viewBox="0 0 24 24">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.84c.62-.75 1.04-1.8 0.92-2.84-.9.04-1.99.6-2.64 1.35-.58.67-.99 1.74-.86 2.76.99.08 2.02-.52 2.58-1.27z"/>
          </svg>
          <span id="section-download-text" data-en={tEn.btnDevLabel} data-id={tId.btnDevLabel}>{tEn.btnDevLabel}</span>
          <span id="section-version-tag" class="text-[11px] px-2 py-0.5 rounded-full bg-white/[0.06] font-mono font-medium text-amber-300 border border-amber-400/20" data-en={tEn.btnDevTag} data-id={tId.btnDevTag}>
            {tEn.btnDevTag}
          </span>
        </a>

        <p id="section-ready-notice" class="text-xs text-neutral-400 leading-relaxed mb-6 max-w-md font-normal text-center" data-en={tEn.devNotice} data-id={tId.devNotice}>
          {tEn.devNotice}
        </p>

        <!-- Spec Badges -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 w-full pt-6 border-t border-white/[0.04]">
          <div class="p-3 rounded-lg bg-white/[0.02] border border-white/[0.05] text-center">
            <span class="block text-[11px] text-neutral-400 font-mono mb-1">Compatibility</span>
            <span class="text-xs font-medium text-neutral-200" data-en={tEn.minOs} data-id={tId.minOs}>{tEn.minOs}</span>
          </div>
          <div class="p-3 rounded-lg bg-white/[0.02] border border-white/[0.05] text-center">
            <span class="block text-[11px] text-neutral-400 font-mono mb-1">Architecture</span>
            <span class="text-xs font-medium text-neutral-200" data-en={tEn.arch} data-id={tId.arch}>{tEn.arch}</span>
          </div>
          <div class="p-3 rounded-lg bg-white/[0.02] border border-white/[0.05] text-center">
            <span class="block text-[11px] text-neutral-400 font-mono mb-1">License</span>
            <span class="text-xs font-medium text-neutral-200" data-en={tEn.license} data-id={tId.license}>{tEn.license}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Developer: Build From Source Card -->
    <div class="p-5 sm:p-6 rounded-xl bg-white/[0.02] border border-white/[0.07] text-left">
      <div class="flex items-center justify-between mb-2">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span class="text-[14px] font-semibold text-white/95" data-en={tEn.buildFromSourceBtn} data-id={tId.buildFromSourceBtn}>
            {tEn.buildFromSourceBtn}
          </span>
        </div>
        <span class="text-[11px] font-mono text-neutral-500">Terminal</span>
      </div>
      <p class="text-[13px] text-neutral-400 font-normal mb-3 leading-relaxed" data-en={tEn.buildFromSourceDesc} data-id={tId.buildFromSourceDesc}>
        {tEn.buildFromSourceDesc}
      </p>
      <div class="relative p-3.5 rounded-lg bg-black/60 border border-white/10 font-mono text-xs text-neutral-300 overflow-x-auto">
        <code>git clone https://github.com/Kharisdestianmaulana-hub/notchify.git<br/>cd notchify &amp;&amp; xcodebuild build -project Notchify.xcodeproj -scheme Notchify</code>
      </div>
    </div>
  </div>
</section>
