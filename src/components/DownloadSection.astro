---
import { translations } from '../data/translations';
const tEn = translations.en.downloadSec;
const tId = translations.id.downloadSec;
---

<section id="download" class="py-20 sm:py-28 md:py-36 relative bg-void overflow-hidden">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
    <!-- App Icon -->
    <div class="w-20 h-20 sm:w-24 sm:h-24 mx-auto mb-6 relative">
      <img
        src={`${import.meta.env.BASE_URL}app-icon.png`}
        alt="Notchify App Icon"
        class="w-full h-full rounded-[22px] shadow-[0_20px_40px_rgba(0,0,0,0.8)] border border-white/10"
        onerror={`this.src='${import.meta.env.BASE_URL}logo.png'`}
      />
    </div>

    <!-- Title & Lede -->
    <h2 class="text-3xl sm:text-5xl font-bold text-white tracking-tight mb-3" data-en={tEn.title} data-id={tId.title}>
      {tEn.title}
    </h2>
    <p class="text-base sm:text-lg text-neutral-400 font-normal leading-relaxed max-w-xl mx-auto mb-10 px-2 sm:px-0" data-en={tEn.subtitle} data-id={tId.subtitle}>
      {tEn.subtitle}
    </p>

    <!-- Main Download Obsidian Card -->
    <div class="p-6 sm:p-10 md:p-12 rounded-3xl bg-[#0a0a0d] border border-white/[0.08] hover:border-white/[0.18] transition-all relative overflow-hidden mb-6 text-center shadow-2xl">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/20 to-transparent pointer-events-none"></div>

      <div class="flex flex-col items-center">
        <!-- Status Banner: In Development / Public Release -->
        <div id="section-status-banner" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/10 text-xs font-mono text-neutral-300 mb-6 max-w-full text-center">
          <span id="section-status-dot" class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse flex-shrink-0"></span>
          <span id="section-status-text" data-en={tEn.statusDevBanner} data-id={tId.statusDevBanner}>
            {tEn.statusDevBanner}
          </span>
        </div>

        <!-- Download Action Button (Disabled while in development, auto-activates when GitHub Release is published) -->
        <a
          id="section-download-btn"
          href="https://github.com/Kharisdestianmaulana-hub/notchify"
          class="inline-flex items-center justify-center gap-2.5 w-full sm:w-auto px-7 py-3.5 rounded-full bg-white/[0.08] border border-white/10 text-neutral-300 font-medium text-sm transition-all cursor-not-allowed select-none mb-3 hover:bg-white/[0.12]"
          aria-disabled="true"
        >
          <svg class="w-4 h-4 fill-current opacity-80" viewBox="0 0 24 24">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.84c.62-.75 1.04-1.8 0.92-2.84-.9.04-1.99.6-2.64 1.35-.58.67-.99 1.74-.86 2.76.99.08 2.02-.52 2.58-1.27z"/>
          </svg>
          <span id="section-download-text" data-en={tEn.btnDevLabel} data-id={tId.btnDevLabel}>{tEn.btnDevLabel}</span>
          <span id="section-version-tag" class="text-[11px] px-2 py-0.5 rounded-full bg-white/[0.06] font-mono font-medium text-neutral-300 border border-white/10" data-en={tEn.btnDevTag} data-id={tId.btnDevTag}>
            {tEn.btnDevTag}
          </span>
        </a>

        <p id="section-ready-notice" class="text-xs text-neutral-400 leading-relaxed mb-8 max-w-md font-normal text-center" data-en={tEn.devNotice} data-id={tId.devNotice}>
          {tEn.devNotice}
        </p>

        <!-- Spec Badges: 4 Obsidian Pills -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5 w-full pt-8 border-t border-white/[0.06]">
          <div class="p-3.5 rounded-2xl bg-white/[0.02] border border-white/[0.06] text-center">
            <span class="block text-[11px] text-neutral-500 font-mono mb-1 uppercase tracking-wider">Compatibility</span>
            <span class="text-xs font-medium text-white" data-en={tEn.minOs} data-id={tId.minOs}>{tEn.minOs}</span>
          </div>
          <div class="p-3.5 rounded-2xl bg-white/[0.02] border border-white/[0.06] text-center">
            <span class="block text-[11px] text-neutral-500 font-mono mb-1 uppercase tracking-wider">Architecture</span>
            <span class="text-xs font-medium text-white" data-en={tEn.arch} data-id={tId.arch}>{tEn.arch}</span>
          </div>
          <div class="p-3.5 rounded-2xl bg-white/[0.02] border border-white/[0.06] text-center">
            <span class="block text-[11px] text-neutral-500 font-mono mb-1 uppercase tracking-wider">Footprint</span>
            <span class="text-xs font-medium text-white" data-en={tEn.size} data-id={tId.size}>{tEn.size}</span>
          </div>
          <div class="p-3.5 rounded-2xl bg-white/[0.02] border border-white/[0.06] text-center">
            <span class="block text-[11px] text-neutral-500 font-mono mb-1 uppercase tracking-wider">License</span>
            <span class="text-xs font-medium text-white" data-en={tEn.license} data-id={tId.license}>{tEn.license}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Previous Versions Card -->
    <div class="p-6 sm:p-7 rounded-3xl bg-[#0a0a0d] border border-white/[0.08] text-left relative overflow-hidden shadow-xl mb-6">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent pointer-events-none"></div>

      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
        <div>
          <h3 class="text-sm sm:text-base font-semibold text-white tracking-tight" data-en={tEn.previousVersionsTitle} data-id={tId.previousVersionsTitle}>
            {tEn.previousVersionsTitle}
          </h3>
          <p class="text-xs text-neutral-400 mt-0.5" data-en={tEn.previousVersionsSubtitle} data-id={tId.previousVersionsSubtitle}>
            {tEn.previousVersionsSubtitle}
          </p>
        </div>

        <div class="flex items-center gap-3">
          <a
            href="#changelog"
            class="text-xs font-medium text-neutral-300 hover:text-white transition-colors flex items-center gap-1"
          >
            <span data-en={tEn.viewChangelogBtn} data-id={tId.viewChangelogBtn}>{tEn.viewChangelogBtn}</span>
            <svg class="w-3.5 h-3.5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <span class="text-white/20">•</span>
          <a
            href="https://github.com/Kharisdestianmaulana-hub/notchify/releases"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-medium text-neutral-400 hover:text-white transition-colors"
            data-en={tEn.allReleasesGithub}
            data-id={tId.allReleasesGithub}
          >
            {tEn.allReleasesGithub}
          </a>
        </div>
      </div>

      <!-- Container for dynamic previous releases list populated by GitHub API -->
      <div id="download-previous-releases" class="space-y-2.5">
        <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/[0.06] text-center text-xs text-neutral-500 font-mono" data-en={tEn.noPreviousYet} data-id={tId.noPreviousYet}>
          {tEn.noPreviousYet}
        </div>
      </div>
    </div>

    <!-- Developer: Build From Source Card (Apple macOS Terminal Style) -->
    <div class="p-6 sm:p-7 rounded-3xl bg-[#0a0a0d] border border-white/[0.08] text-left relative overflow-hidden shadow-xl">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent pointer-events-none"></div>

      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2.5">
          <!-- macOS Terminal Window Dots -->
          <div class="flex items-center gap-1.5 mr-1">
            <span class="w-2.5 h-2.5 rounded-full bg-neutral-700"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-neutral-700"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-neutral-700"></span>
          </div>
          <span class="text-sm font-semibold text-white tracking-tight" data-en={tEn.buildFromSourceBtn} data-id={tId.buildFromSourceBtn}>
            {tEn.buildFromSourceBtn}
          </span>
        </div>
        <span class="text-[11px] font-mono text-neutral-500">Terminal.app</span>
      </div>

      <p class="text-xs text-neutral-400 font-normal mb-3 leading-relaxed" data-en={tEn.buildFromSourceDesc} data-id={tId.buildFromSourceDesc}>
        {tEn.buildFromSourceDesc}
      </p>

      <div class="p-3.5 rounded-xl bg-black/90 border border-white/10 font-mono text-xs text-neutral-300 overflow-x-auto leading-relaxed">
        <code>git clone https://github.com/Kharisdestianmaulana-hub/notchify.git<br/>cd notchify &amp;&amp; xcodebuild build -project Notchify.xcodeproj -scheme Notchify</code>
      </div>
    </div>
  </div>
</section>
