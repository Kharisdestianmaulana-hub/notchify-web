---
import { translations } from '../data/translations';
const tEn = translations.en.footer;
const tId = translations.id.footer;
---

<footer class="py-14 border-t border-white/[0.06] bg-black text-xs text-neutral-400">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Col 1: Brand -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-2.5 mb-3">
          <img src={`${import.meta.env.BASE_URL}logo.png`} alt="Notchify Logo" class="w-7 h-7 rounded-lg" />
          <span class="text-base font-semibold text-white">Notchify</span>
        </div>
        <p class="max-w-md text-neutral-400 leading-relaxed mb-3" data-en={tEn.desc} data-id={tId.desc}>
          {tEn.desc}
        </p>
        <p class="text-neutral-500 text-[11px]" data-en={tEn.disclaimer} data-id={tId.disclaimer}>
          {tEn.disclaimer}
        </p>
      </div>

      <!-- Col 2 & 3: Navigation Links & Open Source (Aligned side-by-side on mobile and desktop) -->
      <div class="grid grid-cols-2 gap-6 sm:gap-8 md:col-span-2">
        <!-- Resources / Tautan -->
        <div>
          <h4 class="font-mono text-[11px] uppercase tracking-wider text-neutral-400 mb-4" data-en={tEn.linksTitle} data-id={tId.linksTitle}>
            {tEn.linksTitle}
          </h4>
          <ul class="space-y-2.5">
            <li><a href="#features" class="hover:text-white transition-colors">Features</a></li>
            <li><a href="#demo" class="hover:text-white transition-colors">Notch Simulator</a></li>
            <li><a href="#utilities" class="hover:text-white transition-colors">Utilities</a></li>
            <li><a href="#permissions" class="hover:text-white transition-colors">Privacy & Security</a></li>
            <li><a href="#faq" class="hover:text-white transition-colors">FAQ</a></li>
            <li><a href="#download" class="hover:text-white transition-colors">Download .dmg</a></li>
          </ul>
        </div>

        <!-- Open Source -->
        <div>
          <h4 class="font-mono text-[11px] uppercase tracking-wider text-neutral-400 mb-4" data-en={tEn.legalTitle} data-id={tId.legalTitle}>
            {tEn.legalTitle}
          </h4>
          <ul class="space-y-2.5">
            <li>
              <a href="https://github.com/Kharisdestianmaulana-hub/notchify" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-1.5">
                <span>GitHub Repository</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </li>
            <li>
              <a href="https://github.com/Kharisdestianmaulana-hub/notchify/releases" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
                Release Notes
              </a>
            </li>
            <li>
              <a href="https://github.com/Kharisdestianmaulana-hub/notchify/issues" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
                Report an Issue
              </a>
            </li>
            <li>
              <a href="https://github.com/Kharisdestianmaulana-hub/notchify/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
                MIT License
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-white/[0.04] flex flex-col sm:flex-row items-center justify-between gap-4 text-neutral-500 font-mono text-[11px]">
      <div>
        © {new Date().getFullYear()} Notchify. <span data-en={tEn.rights} data-id={tId.rights}>{tEn.rights}</span>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
        <span>macOS 12.0+ (Monterey – Terbaru)</span>
        <span>•</span>
        <span>Universal (Apple Silicon & Intel)</span>
        <span>•</span>
        <span>SwiftUI & AppKit</span>
      </div>
    </div>
  </div>
</footer>
