---
import { translations } from '../data/translations';
const tEn = translations.en.permissions;
const tId = translations.id.permissions;
---

<section id="permissions" class="py-16 sm:py-24 md:py-32 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="max-w-2xl mb-10 sm:mb-16 md:mb-20">
      <span class="block text-xs font-mono uppercase tracking-widest text-neutral-500 mb-3">Transparency</span>
      <h2 class="text-2xl sm:text-4xl md:text-5xl font-semibold text-white tracking-tight mb-3 sm:mb-4" data-en={tEn.title} data-id={tId.title}>
        {tEn.title}
      </h2>
      <p class="text-sm sm:text-base md:text-lg text-neutral-400 font-normal leading-relaxed" data-en={tEn.subtitle} data-id={tId.subtitle}>
        {tEn.subtitle}
      </p>
    </div>

    <!-- Editorial 2-Column Permissions (No Cards) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-12 mb-10 sm:mb-16">
      <!-- Item 1: Accessibility -->
      <div class="pt-6 border-t border-white/[0.08]">
        <span class="block text-xs font-mono text-neutral-500 mb-4 tracking-wider">
          01 / ACCESSIBILITY API
        </span>
        <h3 class="text-lg font-medium text-white mb-2.5 tracking-tight" data-en={tEn.accessibilityTitle} data-id={tId.accessibilityTitle}>
          {tEn.accessibilityTitle}
        </h3>
        <p class="text-sm text-neutral-400 leading-relaxed font-normal mb-6" data-en={tEn.accessibilityDesc} data-id={tId.accessibilityDesc}>
          {tEn.accessibilityDesc}
        </p>
        <span class="inline-block text-[11px] font-mono text-neutral-500">
          Global hotkey listener only
        </span>
      </div>

      <!-- Item 2: Screen Recording -->
      <div class="pt-6 border-t border-white/[0.08]">
        <span class="block text-xs font-mono text-neutral-500 mb-4 tracking-wider">
          02 / WINDOW GEOMETRY
        </span>
        <h3 class="text-lg font-medium text-white mb-2.5 tracking-tight" data-en={tEn.screenTitle} data-id={tId.screenTitle}>
          {tEn.screenTitle}
        </h3>
        <p class="text-sm text-neutral-400 leading-relaxed font-normal mb-6" data-en={tEn.screenDesc} data-id={tId.screenDesc}>
          {tEn.screenDesc}
        </p>
        <span class="inline-block text-[11px] font-mono text-neutral-500">
          Pixels are never read or stored
        </span>
      </div>
    </div>

    <!-- Privacy Statement: Editorial Hairline Row -->
    <div class="pt-8 border-t border-white/[0.08] flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="max-w-xl">
        <h4 class="text-base font-medium text-white mb-1.5 tracking-tight" data-en={tEn.privacyPromiseTitle} data-id={tId.privacyPromiseTitle}>
          {tEn.privacyPromiseTitle}
        </h4>
        <p class="text-sm text-neutral-400 leading-relaxed font-normal" data-en={tEn.privacyPromiseDesc} data-id={tId.privacyPromiseDesc}>
          {tEn.privacyPromiseDesc}
        </p>
      </div>
      <div class="flex items-center gap-3 text-xs font-mono text-neutral-500 flex-shrink-0">
        <span>Zero Analytics</span>
        <span>•</span>
        <span>100% Local</span>
      </div>
    </div>
  </div>
</section>
